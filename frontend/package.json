{
  "name": "inspyro-frontend",
  "version": "1.0.1",
  "private": true,
  "dependencies": {
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@monaco-editor/react": "^4.6.0",
    "@xyflow/react": "^12.10.0",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.3.1",
    "katex": "^0.16.28",
    "mammoth": "^1.11.0",
    "marked": "^12.0.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.8",
    "mermaid": "^11.14.0",
    "pdfjs-dist": "^3.11.174",
    "plotly.js-dist-min": "^2.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.2",
    "web-vitals": "^3.5.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "node tests/helpers/runPlaywrightSuite.cjs",
    "test:e2e:headed": "node tests/helpers/runPlaywrightSuite.cjs --headed",
    "test:e2e:keep": "node tests/helpers/runPlaywrightSuite.cjs --keep-harness",
    "test:e2e:report": "playwright show-report output/playwright/report",
    "generate:ws-types": "node scripts/generate_ws_types.mjs",
    "postinstall": "patch-package",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8000",
  "overrides": {
    "bfj": "9.1.3",
    "jsonpath": "1.2.1",
    "minimatch": "10.2.1",
    "nth-check": "2.1.1",
    "postcss": "8.4.31",
    "webpack-dev-server": "4.15.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "patch-package": "^8.0.1",
    "react-scripts": "5.0.1"
  }
